# Скопируй этот файл в .env и впиши свои значения. Файл .env в GitHub НЕ заливается.

# Токен от @BotFather
BOT_TOKEN=123456:replace-me

# Твой Telegram ID (узнать: напиши боту /id). Несколько владельцев — через запятую.
OWNER_ID=123456789

# Grid API — ключ укажи только в настройках переменных окружения BotHost, не в GitHub.
GRID_API_URL=https://keys.gridapi.ru/v1
GRID_API_KEY=
GRID_MODEL=gpt-6.1

# Необязательно:
# DB_PATH=bot.db
# WARN_LIMIT=3
# WARN_MUTE_HOURS=24
# DEFAULT_MUTE_MINUTES=60
